{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Cauce": ""
  },
  "Keycloak": {
    "Authority": "",
    "Realm": "cauce",
    "Audience": "cauce-backend",
    "ClientId": "cauce-backend",
    "ClientSecret": "",
    "RequireHttpsMetadata": false,
    "WaitIncrementSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost:3000"
  },
  "RateLimiting": {
    "Enabled": true
  },
  "Consent": {
    "CurrentVersion": "1.0",
    "Text": "Yo acepto participar voluntariamente en el piloto clínico del sistema Cauce. [El texto definitivo será provisto por el equipo clínico del Complejo Hospitalario Guillermo Kaelín de la Fuente antes del inicio del piloto. Este placeholder satisface el cumplimiento estructural durante el desarrollo.]"
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 25,
    "UseSsl": true,
    "FromAddress": "no-reply@cauce.local",
    "FromName": "Cauce",
    "MobileAppBaseUrl": "",
    "PortalAppBaseUrl": ""
  },
  "AdminApi": {
    "Value": ""
  },
  "KeyDb": {
    "ConnectionString": "localhost:6379"
  },
  "Notifications": {
    "Fcm": {
      "UseFake": true,
      "CredentialsPath": ""
    }
  },
  "Storage": {
    "Minio": {
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "UseSsl": false,
      "ReportsBucket": "clinical-reports"
    }
  },
  "Reports": {
    "PresignedUrlValidityHours": 24,
    "PasswordLength": 12,
    "TopFrequentFoods": 10
  },
  "Workers": {
    "OutboxDispatcher": { "Enabled": true },
    "NotificationDispatcher": { "Enabled": true },
    "RecommendationExpiration": { "Enabled": true },
    "OutboxRetention": { "Enabled": true },
    "WeeklyReminder": { "Enabled": true }
  },
  "Recommendations": {
    "EngineKind": "Rule",
    "CandidateFoodsWindowDays": 14,
    "MinCandidateFoodsCount": 5,
    "AutoApprovalEnabled": false,
    "AutoApprovalThreshold": 0.95,
    "MaxAvoidItemsForAutoApproval": 3,
    "ExpirationWindowHours": 72,
    "AvoidThreshold": 0.70,
    "ReduceThreshold": 0.45,
    "Ollama": {
      "Endpoint": "http://ollama:11434/api/generate",
      "Model": "llama3.1:8b-instruct-q4_K_M",
      "TimeoutSeconds": 15,
      "MaxOutputCharacters": 500,
      "MinOutputCharacters": 80
    }
  }
}
