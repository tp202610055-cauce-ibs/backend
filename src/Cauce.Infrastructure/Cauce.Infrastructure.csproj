<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cauce.Application\Cauce.Application.csproj" />
    <ProjectReference Include="..\Cauce.Domain\Cauce.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cauce.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.*" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.*" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.7" />
    <PackageReference Include="QuestPDF" Version="2024.12.*" />
    <PackageReference Include="PdfSharp" Version="6.1.*" />
    <PackageReference Include="ScottPlot" Version="5.0.*" />
    <PackageReference Include="Minio" Version="6.0.*" />
    <PackageReference Include="FirebaseAdmin" Version="3.1.*" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.*" />
  </ItemGroup>

  <!--
    El servicio CurrentUserService lee el HttpContext (IHttpContextAccessor,
    IHeaderDictionary) y AddHttpContextAccessor. En .NET 9, estos tipos viven en
    el framework compartido ASP.NET Core, no en el paquete heredado
    Microsoft.AspNetCore.Http.Abstractions 2.3.x. Se referencia el framework
    compartido para acceder a esas abstracciones desde una biblioteca de clases.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
